#!/usr/bin/env bash
#
# Cheatsheet des raccourcis Hyprland.
#
# Ne maintient aucune liste : lit `hyprctl binds`, ne garde que les
# raccourcis qui portent une description, decode le masque de
# modificateurs, et envoie le tout dans walker en mode dmenu.
#
# Dependances : jq, walker (+ elephant qui tourne)
#
# Usage :
#   keybindings            affiche le selecteur
#   keybindings --print    ecrit sur la sortie standard (utile pour grep)

set -euo pipefail

command -v jq >/dev/null || { echo "jq manquant : sudo dnf install jq" >&2; exit 1; }

# Le champ modmask est un entier bitmask. jq n'a pas d'operateurs
# binaires, on teste donc chaque bit par division entiere.
#   SHIFT 1 | CAPS 2 | CTRL 4 | ALT 8 | MOD2 16 | MOD3 32 | SUPER 64 | MOD5 128
FILTER='
  def bit($m; $b): (($m / $b) | floor) % 2 == 1;
  .[]
  | select(.description != null and .description != "")
  | ( [ if bit(.modmask; 64) then "SUPER" else empty end,
        if bit(.modmask; 4)  then "CTRL"  else empty end,
        if bit(.modmask; 8)  then "ALT"   else empty end,
        if bit(.modmask; 1)  then "SHIFT" else empty end
      ] | join(" + ") ) as $mods
  | ( if .key != "" then .key else "code:" + (.keycode | tostring) end ) as $key
  | ( if $mods == "" then $key else $mods + " + " + $key end )
    + "\t" + .description
'

# Les keysyms AZERTY sortent sous leur nom X11 ("ampersand"), illisible
# dans une aide. On les retraduit en caracteres.
prettify() {
  sed -e 's/\bampersand\b/\&/'    -e 's/\beacute\b/é/' \
      -e 's/\bquotedbl\b/"/'      -e 's/\bapostrophe\b/'"'"'/' \
      -e 's/\bparenleft\b/(/'     -e 's/\bminus\b/-/' \
      -e 's/\begrave\b/è/'        -e 's/\bunderscore\b/_/' \
      -e 's/\bccedilla\b/ç/'      -e 's/\bagrave\b/à/' \
      -e 's/\bmouse_down\b/molette bas/' \
      -e 's/\bmouse_up\b/molette haut/' \
      -e 's/mouse:272/clic gauche/' -e 's/mouse:273/clic droit/' \
      -e 's/\bXF86Audio/ /'       -e 's/\bXF86MonBrightness/Luminosité /'
}

align() {
  if command -v column >/dev/null; then
    column -t -s $'\t'
  else
    expand -t 40
  fi
}

bindings() {
  hyprctl binds -j \
    | jq -r "$FILTER" \
    | prettify \
    | sort -f \
    | align
}

if [[ "${1:-}" == "--print" ]]; then
  bindings
  exit 0
fi

# walker --dmenu lit l'entree standard et renvoie la ligne choisie.
# On ignore la selection : ce menu est une aide, pas un lanceur.
bindings | walker --dmenu >/dev/null 2>&1 || true
